# Pipeline artifacts — parquet, candidates, item vectors, checkpoints, MLflow store
# (trd.md §4, §11). Multi-GB. Regenerated by `contentsignal ingest` and downstream stages.
/artifacts/
mlruns/

# Raw CSVs — 3.7 GB, whether downloaded from Kaggle or dropped in by hand. Kept after parquet
# conversion (deleting a hand-supplied input is not the pipeline's call), and never tracked.
#
# Anchored with a leading slash on purpose. An unanchored `data/` matches at ANY depth, so
# it also swallows `src/contentsignal/data/` — the ingest package (download.py, to_parquet.py,
# schema.py) — and those files would be silently untracked rather than rejected.
/data/
*.csv
*.csv.zip

# Credentials
kaggle.json
.env
.env.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# macOS
.DS_Store

# NOTE: reports/ is deliberately NOT ignored. reports/metrics/*.json is the
# committed record of every run's numbers, and `make report` regenerates
# reports/results.md from it (trd.md §11).
